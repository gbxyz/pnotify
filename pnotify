#!/usr/bin/env perl
use Net::DNS 1.55;
use Getopt::Long;
use Pod::Usage;
use strict;

my ($zone, $server, $srv, $dsync, $class, $port, $tsig_name, $tsig_key, $tsig_alg, $timeout, $source, $report_channel, $help);
GetOptions(
    'zone=s'            => \$zone,
    'server=s'          => \$server,
    'srv=s'             => \$srv,
    'dsync:s'           => \$dsync, # optional (hence : not =)
    'class=s'           => \$class,
    'port=i'            => \$port,
    'tsig-name=s'       => \$tsig_name,
    'tsig-key=s'        => \$tsig_key,
    'tsig-alg=s'        => \$tsig_alg,
    'timeout=i'         => \$timeout,
    'source=s'          => \$source,
    'report-channel=s'  => \$report_channel,
    'help'              => \$help,
) or pod2usage(1);

pod2usage(1) if ($help);

$zone ||= shift(@ARGV);

if ($zone eq '') {
    print "pnotify: --zone argument is missing or empty\n";
    pod2usage(1);
}

my $resolver = Net::DNS::Resolver->new(dnssec => 1);

my @servers;
if ($srv ne '') {
    resolve_srv();

} elsif ($dsync) {
    resolve_dsync();

} elsif ($server ne '') {
    push(@servers, $server);

} else {
    print "pnotify: --server, --srv or --dsync arguments are missing or empty\n";
    pod2usage(1);

}

if (scalar(@servers) < 1) {
    print "pnotify: no servers found\n";
    exit(1);
}

my $packet = Net::DNS::Packet->new($zone, 'SOA', ($class || 'IN'));
$packet->header->opcode('NS_NOTIFY_OP');
$packet->header->aa(1);
$packet->header->rd(0);
$packet->header->rcode('NOERROR');

if ($report_channel ne '') {
    $packet->header->do(1);
    $packet->edns->option('REPORT-CHANNEL' => {'AGENT-DOMAIN' => $report_channel});
}

if ($tsig_name ne '' && $tsig_key ne '') {
    $packet->sign_tsig(Net::DNS::RR->new(
        name        => $tsig_name,
        type        => 'TSIG',
        algorithm   => $tsig_alg || 'HMAC-MD5',
        key         => $tsig_key,
    ));
}

my $errors = 0;
foreach my $server (@servers) {
    my $use_port = $port;

    if ('ARRAY' eq ref($server)) {
        ($server, $use_port) = @{$server};
    }

    $resolver->nameserver($server);
    $resolver->udp_timeout($timeout || 1);
    $resolver->srcaddr($source) if ($source ne '');
    $resolver->port($use_port // 53);

    my $answer = $resolver->send($packet);
    if ($answer) {
        printf("%s: %s\n", $server, $answer->header->rcode);
        $errors++ if ($answer->header->rcode ne 'NOERROR');

    } else {
        printf("%s: TIMEOUT\n", $server);
        $errors++;

    }
}

exit($errors);

sub resolve_srv {
    my $answer = $resolver->send('_dns._udp.'.$srv, 'SRV');
    if (!$answer) {
        print "pnotify: no answer received when querying for _dns._udp.$srv/SRV\n";
        exit(1);

    } elsif ($answer->header->rcode ne 'NOERROR') {
        print "pnotify: received ".$answer->header->rcode." when querying for _dns._udp.$srv/SRV\n";
        exit(1);

    } elsif ($answer->header->ancount < 0) {
        print "pnotify: received no answer records when querying for _dns._udp.$srv/SRV\n";
        exit(1);

    } else {
        foreach my $rr (grep { 'SRV' eq $_->type} $answer->answer) {
            push(@servers, $rr->port == 53 ? $rr->target : [$rr->target, $rr->port]);
        }
    }
}

#
# this implements the procedure in Section 4.1 of RFC 9859
#
sub resolve_dsync {
    if (defined($dsync) && $dsync ne '' && $dsync ne 'CDS' && $dsync ne 'CSYNC') {
        print "pnotify: invalid --dsync value '$dsync', must be either CDS or CSYNC\n";
        exit(1);
    }

    my ($name, $name_provided);

    if ($_[0]) {
        $name = $_[0];
        $name_provided = 1;

    } else {
        my @labels = Net::DNS::Domain->new($zone)->label;
        splice(@labels, 1, 0, '_dysnc');
        $name = join('.', @labels).'.';
    }

    my $answer = $resolver->send($name, 'IN', 'DSYNC');

    if (!$answer) {
        print "pnotify: no answer received when querying for $name/DSYNC\n";
        exit(1);

    } elsif ($answer->header->rcode eq 'NOERROR' && $answer->header->ancount > 0) {
        foreach my $rr (grep { 'DSYNC' eq $_->type} $answer->answer) {
            if (1 == $rr->scheme && ($dsync eq '' || $dsync eq $rr->rrtype)) {
                push(@servers, $rr->port == 53 ? $rr->target : [$rr->target, $rr->port]);
            }
        }

    } elsif (!$name_provided) {
        my $parent_len = (Net::DNS::Domain->new([ grep { 'SOA' eq $_->type } $answer->authority ]->[0]->name)->label);

        my @labels = Net::DNS::Domain->new($zone)->label;
        splice(@labels, 0-$parent_len, 0, '_dysnc');
        $name = join('.', @labels).'.';

        resolve_dsync($name);

    } else {
        print "pnotify: no DSYNC endpoint found for $zone\n";
        exit(1);

    }
}

__END__

=head1 NAME

pnotify - A simple, portable Perl script for sending DNS NOTIFY packets
with TSIG support.

=head1 SYNOPSIS

pnotfy [OPTIONS] [ZONE]

Options:

    --zone=ZONE             The DNS zone (can also be passed as a bare
                            argument)
    --class=CLASS           The class (default IN)
    --server=HOST           Host to send the packet to, OR
    --dsync[=TYPE]          Use DSYNC (RFC 9859) to determine the
                            destination. Specify a value to limit the
                            notifications to TYPE (either CDS or CSYNC).
    --srv=DOMAIN            FQDN to use to construct _dns._udp SRV query
                            to determine which servers to send the
                            NOTIFY to
    --port=PORT             Destination port to send the packet to
                            (default 53, ignored if --srv or --dsync are
                            used)
    --timeout=TIMEOUT       Timeout in seconds (default 1)
    --tsig-name=NAME        Optional TSIG name
    --tsig-key=KEY          Optional TSIG KEY
    --tsig-algorithm=NAME   Optional TSIG algorithm (default HMAC-MD5)
    --source=ADDR           Use this source address (optional)
    --report-channel=DOMAIN Specify RFC 9567 report channel (optional)
    --help                  Show this help

=head1 SENDING MULTIPLE PACKETS

You can send a NOTIFY to a single host using the --server argument. If
you provide a value for the --srv argument, then pnotify will perform
a SRV lookup and retrieve a list of servers, and send a packet to each.

For example: if you used C<--srv=example.com>, pnotify will perform a SRV
query for C<_dns._udp.example.com>. A NOTIFY packet will then be sent to
each host in the response to the SRV query.

=head2 DSYNC support

pnotify supports DSYNC (L<RFC 9859|https://www.rfc-editor.org/rfc/rfc9859.html>).
If you pass the --dsync argument, it will look for the DSYNC endpoint(s)
published by the parent operator and extract the target(s) and port(s)
found. You can limit the endpoints that messages are sent to be
providing a value, either C<CDS> or C<CSYNC>.

=head1 OUTPUT

pnotify will print the rcode of the response from each server or
"TIMEOUT" to STDOUT.

=head1 EXIT CODE

The exit code will be equal to the number of errors observed.

=head1 RATIONALE

It is sometimes useful to be able to manually send a NOTIFY packet to a
DNS server. There are other tools to do this (eg nsd-notify(8)) but they
are not as portable as pnotify, which is a pure Perl script with only a
limited range of prerequisites.

